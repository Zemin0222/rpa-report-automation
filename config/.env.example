# 运行模式
RPA_HEADLESS=true
MOCK_BASE_URL=http://127.0.0.1:8765

# 模拟后台登录账号 (与 mock_systems/server.py 默认账号一致)
CRM_USERNAME=ops_admin
CRM_PASSWORD=rpa_demo_pass
ADS_USERNAME=ads_manager
ADS_PASSWORD=rpa_ads_pass
FINANCE_USERNAME=fin_admin
FINANCE_PASSWORD=rpa_fin_pass
OA_USERNAME=oa_staff
OA_PASSWORD=rpa_oa_pass
EXPENSE_USERNAME=fin_staff
EXPENSE_PASSWORD=rpa_exp_pass

# Web 工作台可选访问口令 (留空则免密访问；部署到公网云主机时建议设置)
DASHBOARD_PASSWORD=

# 通知推送配置 (默认 dry_run=true 不发真实消息；如群机器人开启签名校验请填 SECRET)
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# 企业邮箱 IMAP 附件自动采集 (可选，启用 imap_mail 采集器时填写)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# 可选 AI 经营结论生成 (支持 OpenAI 兼容接口或阿里云 DashScope)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
